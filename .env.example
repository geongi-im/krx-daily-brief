# 이 파일을 .env 로 복사한 뒤 값만 채워 넣으면 된다.
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (bash)
# .env 자체는 .gitignore 에 있어 커밋되지 않는다. 실제 값은 여기 적지 말 것.

# ---------------------------------------------------------------------------
# [필수] KRX 정보데이터시스템 계정 (data.krx.co.kr 무료 회원가입)
# ---------------------------------------------------------------------------
# 리포트 데이터 수집에 필요하다. 비어 있으면 main.py 가 '휴장일' 처럼 보이는
# 조회 오류로 실패하므로, 먼저 `python main.py --check` 로 로그인을 확인하라.
#
# pykrx 자체는 KRX_ID / KRX_PW 라는 이름만 읽지만, main.py 가 아래 이름의 값을
# 그 이름으로 옮겨 주므로 여기에만 적어두면 된다.
KRX_LOGIN_ID=
KRX_LOGIN_PASSWORD=

# ---------------------------------------------------------------------------
# [선택] 리포트 API 전송 — utils/api_util.py
# ---------------------------------------------------------------------------
# 생성된 HTML 리포트를 게시판 API로 보낼 때 쓴다. ApiUtil() 은 이 값이 없으면
# 생성 시점에 EnvironmentError 를 던지므로, 전송을 쓰지 않는다면 비워 둬도 되지만
# 그 경우 ApiUtil 을 호출하지 않도록 해야 한다.
# 끝의 /api 는 ApiUtil 이 붙이므로 여기엔 스킴+호스트까지만 적는다.
#   예) BASE_URL=https://example.com   ->  https://example.com/api/board-research
BASE_URL=

# ---------------------------------------------------------------------------
# [선택] 텔레그램 알림 — utils/telegram_util.py
# ---------------------------------------------------------------------------
# 리포트 생성/전송 결과와 실패 알림을 보낼 때 쓴다.
# BOT_TOKEN 은 @BotFather 에서, CHAT_ID 는 봇을 초대한 방에서 확인한다.
TELEGRAM_BOT_TOKEN=
# 운영 알림이 가는 채팅방
TELEGRAM_CHAT_ID=
# send_test_message() 가 쓰는 테스트/에러 전용 채팅방
TELEGRAM_CHAT_TEST_ID=
